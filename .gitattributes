# Line Endings: LF for source code uniformly, CRLF for Windows scripts (to avoid weird issues when double-clicked)
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# Explicit text declarations
*.py   text
*.js   text
*.json text
*.md   text
*.html text
*.css  text
*.yml  text
*.yaml text
*.txt  text

# Binaries: Prevent line ending conversion / diff pollution
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.vrm binary
*.task binary

# Large files (Exclude from git by default - see .gitignore; if LFS management is needed, change the rules below to
#   "*.pt filter=lfs diff=lfs merge=lfs -text" format, and run `git lfs install` first)
*.safetensors binary
*.pt binary
*.pth binary
*.bin binary
*.onnx binary
*.pyd binary
*.dll binary
*.exe binary
*.lib binary
*.npz binary
*.npy binary
*.ckpt binary
*.zip binary

# This repo is a Windows application: Do not auto-modify assets like PNGs in diff/merge
*.png -diff
*.jpg -diff
*.wav -diff
